# ECO Professional DP Generator – environment configuration
# Copy to .env.local (development) or set in your hosting platform. NEVER commit real values.

# ---- Branding --------------------------------------------------------------
# Official ECO logo file (PNG). Default: public/brand/eco-logo.png
# ECO_LOGO_PATH=
# Optional transparent-background watermark variant from the ECO brand team (looks best on white):
# ECO_WATERMARK_LOGO_PATH=public/brand/eco-logo-watermark.png
WATERMARK_OPACITY=0.13

# ---- AI processing ------------------------------------------------------------
# "local" = AI models run on ECO's own server; photographs are not sent to any third party (default, recommended)
# "removebg" = external provider. Only after IT / Legal / InfoSec approval.
AI_PROVIDER=local
EXTERNAL_AI_PROVIDER_APPROVED=false
REMOVE_BG_API_KEY=
MODELS_DIR=./models
MAX_CONCURRENT_JOBS=2
MAX_UPLOAD_MB=12

# ---- Database (Supabase / Postgres) – server-side only -----------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Development only: JSON file store (refused in production unless explicitly enabled)
# ALLOW_FILE_STORE=true
# FILE_STORE_PATH=.data/store.json

# ---- Admin dashboard ---------------------------------------------------------
# Generate with:  npm run hash-password -- "a long strong password"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Optional comma-separated allow-list of admin IP addresses (e.g. ECO office / VPN egress)
ADMIN_IP_ALLOWLIST=

# ---- Privacy -----------------------------------------------------------------
PRIVACY_NOTICE_VERSION=2026-11-v1-DRAFT
PRIVACY_CONTACT_EMAIL=
GRIEVANCE_OFFICER_NAME=
# Retention periods in days – to be approved by ECO Legal
PARTICIPANT_RECORD_RETENTION_DAYS=180
CONSENT_LOG_RETENTION_DAYS=365
PRIVACY_REQUEST_RETENTION_DAYS=365
# Secret for the scheduled deletion endpoint GET /api/cron/retention (Authorization: Bearer <secret>)
CRON_SECRET=

# ---- Branch list shown to users ------------------------------------------------
BRANCHES=Delhi NCR,Gurugram,Noida,Mumbai,Pune,Bengaluru,Hyderabad,Chennai,Kolkata,Ahmedabad,Other
